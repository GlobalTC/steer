# Optional voice services (copy to review/.voice.env). No keys are hardcoded in the desk.

# Server speech-to-text (in-car / tablet browsers without Web Speech).
# POST multipart "audio" or JSON { "audio_base64", "content_type" } when VOICE_STT_MODE=json.
# Response: { "transcript": "..." }. Audio is not stored on disk.
# VOICE_STT_URL=https://your-stt.example/v1/transcribe
# VOICE_STT_KEY=
# VOICE_STT_HEADER=Authorization
# VOICE_STT_MODE=multipart

# Dictation mark resolution — LLM first, heuristics if unreachable.
# Grok Bot hosts: set XAI_API_KEY in the environment (uses https://api.x.ai/v1) or override:
# STEER_LLM_BASE_URL=https://api.x.ai/v1
# STEER_LLM_API_KEY=
# STEER_LLM_MODEL=grok-2-latest
# Optional custom resolver URL (JSON proposals in/out):
# VOICE_RESOLVE_URL=https://your-resolver.example/v1/steer-voice
# VOICE_RESOLVE_KEY=
# VOICE_RESOLVE_HEADER=Authorization
